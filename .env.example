PGHOST=localhost
PGPORT=5432
PGDATABASE=balykkz
PGUSER=balykkz_app
PGPASSWORD=
POSTGRES_USER=postgres
POSTGRES_PASSWORD=

# Admin account: use a unique email and a strong random password (12+ characters).
# Keep actual values in an ignored .env file or hosting-provider secrets.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Администратор

# Password-reset email via SMTP. Leave empty until an email provider is configured.
# Generate PASSWORD_RESET_SECRET as a random value with at least 32 characters.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
PASSWORD_RESET_SECRET=

# Public DNS name pointed to the server's IP for automatic HTTPS via Caddy.
SITE_ADDRESS=